    "paths": {
        "/api/checkout/process": {
            "post": {
                "tags": [
                    "Checkout"
                ],
                "summary": "Procesar Checkout",
                "description": "Procesamiento híbrido de checkout combinando billetera virtual o Stripe con alta seguridad.",
                "operationId": "44ff9c9c81a7fe7a0e14c275c50f8bfb",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "payment_method": {
                                        "description": "wallet o stripe",
                                        "type": "string",
                                        "example": "wallet"
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "purchasable_type": {
                                                    "type": "string",
                                                    "example": "App\\Models\\Card"
                                                },
                                                "purchasable_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "quantity": {
                                                    "type": "integer",
                                                    "example": 1
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Compra procesada o sesión de pago iniciada"
                    },
                    "422": {
                        "description": "Datos de orden inválidos o stock insuficiente"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
